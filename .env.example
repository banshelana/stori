# ---------------------------------------------------------------
# Data source used at BUILD time for static generation.
# Values: "mock" | "api"
# The runtime toggle in the UI can override this per-browser.
# ---------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of your backend/API (only used when source = "api").
# This should point to a REST backend that mirrors the mock shape.
# Example: https://api.example.com
NEXT_PUBLIC_API_URL=

# Optional API key forwarded as Authorization: Bearer <token>.
# Only safe to expose publicly if your API uses CORS + public keys.
NEXT_PUBLIC_API_TOKEN=

# ---------------------------------------------------------------
# Map tiles. Leaflet itself is bundled locally, but tiles are fetched
# from this URL at runtime — the one part of the app that needs the
# network. Point these at your own tile server to go fully offline.
# The default is OpenStreetMap, whose usage policy requires the
# attribution to stay visible: https://operations.osmfoundation.org/policies/tiles/
# ---------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
